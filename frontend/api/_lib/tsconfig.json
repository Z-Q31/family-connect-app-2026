{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "../../netlify/functions/_lib",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}